{
  "manifest_version": 3,
  "name": "Claude Terminal Bridge",
  "version": "1.0.0",
  "description": "Connects Claude to a local Rust terminal application.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": [
        "claude-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
